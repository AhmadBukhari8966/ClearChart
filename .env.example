# Existing connections can remain unchanged. Never commit real credentials.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Optional for standard Supabase DSNs; inferred from their project reference.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Existing NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY or SUPABASE_ANON_KEY also works.
HOST=127.0.0.1
PORT=8080
# Set true behind an HTTPS reverse proxy; false for local plain HTTP.
COOKIE_SECURE=false
