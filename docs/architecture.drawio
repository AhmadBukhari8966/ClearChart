<diagram id="startup" name="01 - Startup and requests"><mxGraphModel dx="1320" dy="1130" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="1130"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="01 - Startup and requests&#xa;Follow main.go first. One Go process owns HTTP, sessions, templates and the selected store." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="15" width="1220" height="60" as="geometry"/></mxCell>
<mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="main" target="context"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="context" target="dsn"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="unset" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="dsn" target="memory"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="set" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="dsn" target="postgres"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="memory" target="app"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="postgres" target="app"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="app" target="router"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="router" target="serve"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="request" target="serve"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="serve" target="handler"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e10" value="Ctrl+C" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="context" target="shutdown"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="main" value="1. main()&#xa;main.go" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f0e9;strokeColor=#3b7256;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="480" y="85" width="350" height="70" as="geometry"/></mxCell>
<mxCell id="context" value="2. Interrupt-aware context&#xa;signal.NotifyContext + defer stop" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf3f9;strokeColor=#5c7e9e;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="480" y="195" width="350" height="75" as="geometry"/></mxCell>
<mxCell id="dsn" value="3. Read DATABASE_URL&#xa;Choose one Store implementation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3df;strokeColor=#b17b2c;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="480" y="310" width="350" height="80" as="geometry"/></mxCell>
<mxCell id="memory" value="Absent: NewMemoryStore()&#xa;Base seed + addBulkPatients()&#xa;Maps/slices; changes vanish on stop" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf3f9;strokeColor=#5c7e9e;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="70" y="445" width="350" height="95" as="geometry"/></mxCell>
<mxCell id="postgres" value="Present: NewPostgresStore()&#xa;sql.Open pool + PingContext&#xa;Failure stops startup" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f0e9;strokeColor=#3b7256;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="890" y="445" width="350" height="95" as="geometry"/></mxCell>
<mxCell id="app" value="4. newApp(store, mode)&#xa;Parse embedded templates&#xa;Create sessions map + eventHub" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf3f9;strokeColor=#5c7e9e;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="480" y="575" width="350" height="95" as="geometry"/></mxCell>
<mxCell id="router" value="5. routes()&#xa;ServeMux + security headers" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf3f9;strokeColor=#5c7e9e;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="480" y="710" width="350" height="80" as="geometry"/></mxCell>
<mxCell id="serve" value="6. ListenAndServe()&#xa;HOST / PORT; default 127.0.0.1:8080&#xa;Handle requests concurrently" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f0e9;strokeColor=#3b7256;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="480" y="830" width="350" height="85" as="geometry"/></mxCell>
<mxCell id="request" value="Browser request&#xa;GET page or live stream&#xa;POST form" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf3f9;strokeColor=#5c7e9e;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="70" y="830" width="350" height="85" as="geometry"/></mxCell>
<mxCell id="handler" value="Handler → Store → Dashboard/record&#xa;render() → HTML or patch() → SSE&#xa;Browser renders / Datastar morphs" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf3f9;strokeColor=#5c7e9e;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="480" y="960" width="350" height="95" as="geometry"/></mxCell>
<mxCell id="shutdown" value="Interrupt: shutdown goroutine&#xa;hub.close() + 5-second Shutdown&#xa;Current main does not await completion" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3df;strokeColor=#b17b2c;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="890" y="710" width="350" height="95" as="geometry"/></mxCell>
<mxCell id="embed" value="Before main: go build / go run .&#xa;Embed templates/*.html + static/*&#xa;No runtime template watcher&#xa;Edit → rebuild/restart" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f2f4f5;strokeColor=#819098;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="70" y="195" width="350" height="105" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="note" name="02 - Save note and update tabs"><mxGraphModel dx="1320" dy="910" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="910"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="02 - Save note and update tabs&#xa;POST and long-lived GET are separate HTTP requests. The hub carries notifications, not patient records." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="15" width="1220" height="60" as="geometry"/></mxCell>
<mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="doctor" target="validate"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="validate" target="write"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="write" target="render"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="render" target="author"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="render" target="publish"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="subscribe" target="event"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="publish" target="event"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="event" target="load"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="load" target="snapshot"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="snapshot" target="receiver"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="doctor" value="1. Doctor submits form&#xa;@post('/add-record', form)&#xa;csrf + doctor_id + patient_id + view_id" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f0e9;strokeColor=#3b7256;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="340" height="105" as="geometry"/></mxCell>
<mxCell id="validate" value="2. addRecord()&#xa;Parse → session/CSRF/origin checks&#xa;Care-team check + validate content" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf3f9;strokeColor=#5c7e9e;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="480" y="110" width="340" height="105" as="geometry"/></mxCell>
<mxCell id="write" value="3. Store.AddRecord()&#xa;memoryStore OR postgresStore&#xa;Persist and return saved Record" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f0e9;strokeColor=#3b7256;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="910" y="110" width="340" height="105" as="geometry"/></mxCell>
<mxCell id="render" value="4. render('record', record)&#xa;startSSE + patch('#timeline', prepend)&#xa;writeCounts + feedback" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf3f9;strokeColor=#5c7e9e;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="480" y="310" width="340" height="110" as="geometry"/></mxCell>
<mxCell id="author" value="Authoring tab updates immediately&#xa;Datastar applies POST response&#xa;POST ends; existing GET stays open" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f0e9;strokeColor=#3b7256;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="310" width="340" height="110" as="geometry"/></mxCell>
<mxCell id="subscribe" value="Other tabs already have GET /events&#xa;events(): authenticate + subscribe&#xa;Initial snapshot then wait" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf3f9;strokeColor=#5c7e9e;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="910" y="310" width="340" height="110" as="geometry"/></mxCell>
<mxCell id="publish" value="5. hub.publish(patientID, viewID)&#xa;Nonblocking notification&#xa;Same-view immediate echo skipped" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf3f9;strokeColor=#5c7e9e;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="480" y="505" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="event" value="6. events() wakes&#xa;Relevant patient notification&#xa;OR 15-second timer" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf3f9;strokeColor=#5c7e9e;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="910" y="505" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="load" value="7. dashboardData()&#xa;Recheck selected chart access&#xa;Read current Store data" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf3f9;strokeColor=#5c7e9e;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="910" y="695" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="snapshot" value="8. snapshot() → patch()&#xa;Timeline, reports/uploads, summary&#xa;Healing and counts" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf3f9;strokeColor=#5c7e9e;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="480" y="695" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="receiver" value="9. Other tabs update&#xa;SSE HTML patches apply in place&#xa;Patient sees doctor's saved note" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f0e9;strokeColor=#3b7256;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="695" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="limit" value="Transport boundaries&#xa;HTTP actions send user changes&#xa;SSE sends server changes&#xa;Hub is local to this Go process" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f2f4f5;strokeColor=#819098;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="505" width="340" height="100" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="selection" name="03 - Patient selection without scroll reset"><mxGraphModel dx="1320" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="1050"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="03 - Patient selection without scroll reset&#xa;Keep the directory DOM stable; update the selected chart and replace its live subscription." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="15" width="1220" height="60" as="geometry"/></mxCell>
<mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="click" target="signal"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="signal" target="effect"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="effect" target="cancel"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="cancel" target="server"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="server" target="context"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="context" target="snapshot"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="context" target="forms"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="snapshot" target="refresh"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="refresh" target="draft"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="click" value="1. Click patient anchor&#xa;data-on:click__prevent&#xa;Skip selection while saving note" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f0e9;strokeColor=#3b7256;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="signal" value="2. $selectedpatient = patient UUID&#xa;chosen class + aria-current update&#xa;The page shell remains mounted" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf3f9;strokeColor=#5c7e9e;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="480" y="110" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="effect" value="3. Root data-effect reruns&#xa;@get uses fixed /events/doctor URL&#xa;Only selectedpatient signal sent" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf3f9;strokeColor=#5c7e9e;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="910" y="110" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="cancel" value="4. Previous request canceled&#xa;Old stream exits on context.Done()&#xa;Rapid clicks end on final selection" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf3f9;strokeColor=#5c7e9e;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="910" y="295" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="server" value="5. events() reads datastar JSON&#xa;Validate role/session/profile&#xa;dashboardData() checks care team" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf3f9;strokeColor=#5c7e9e;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="480" y="295" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="context" value="6. doctorContext() on stream start&#xa;#selected-patient-summary&#xa;#health-timeline + #new-record" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf3f9;strokeColor=#5c7e9e;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="295" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="snapshot" value="7. snapshot()&#xa;Records + reports + healing&#xa;AI summary + counts" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf3f9;strokeColor=#5c7e9e;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="485" width="340" height="105" as="geometry"/></mxCell>
<mxCell id="forms" value="Form IDs include patient UUID&#xa;Draft clears on patient switch&#xa;Old form disabled while selection pending" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3df;strokeColor=#b17b2c;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="480" y="485" width="340" height="105" as="geometry"/></mxCell>
<mxCell id="directory" value="Directory is NOT patched&#xa;Same node + same scrollTop&#xa;Page stays in same document" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f0e9;strokeColor=#3b7256;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="910" y="485" width="340" height="105" as="geometry"/></mxCell>
<mxCell id="refresh" value="8. Later live snapshots&#xa;Same selected patient&#xa;Form is not part of regular snapshot" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf3f9;strokeColor=#5c7e9e;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="685" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="draft" value="Current draft survives live refresh&#xa;Patient data stays server-authorized&#xa;No client-side data cache" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f0e9;strokeColor=#3b7256;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="480" y="685" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="url" value="URL/history is unchanged&#xa;Reload follows URL/default patient&#xa;Anchor href remains as fallback" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f2f4f5;strokeColor=#819098;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="910" y="685" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="contract" value="Preserve this contract when extending the app&#xa;Stable root + fixed action URL + patient-specific form IDs + scoped server checks&#xa;The authoring POST response must never land in another patient's chart." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f2f4f5;strokeColor=#819098;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="270" y="865" width="760" height="100" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="database" name="04 - Database relationships"><mxGraphModel dx="1320" dy="1110" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="1110"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="04 - Database relationships&#xa;All tables are in public. UUID identifiers link profiles; roles distinguish patients from doctors." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="15" width="1220" height="60" as="geometry"/></mxCell>
<mxCell id="e0" value="patient and doctor roles" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="profiles" target="care"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e1" value="patient_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="profiles" target="uploads"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="doctor_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="profiles" target="biometrics"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="patient_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="profiles" target="healing"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="192.5"/><mxPoint x="410" y="755"/></Array></mxGeometry></mxCell>
<mxCell id="e4" value="1 care pair → 0..many records" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#62786d;fontSize=12;labelBackgroundColor=#fafcf9;" edge="1" parent="1" source="care" target="records"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="profiles" value="profiles&#xa;PK id; role = doctor | patient&#xa;name, email (case-insensitive unique)&#xa;doctor: license_num, specialization&#xa;patient: dob, blood_type" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f0e9;strokeColor=#3b7256;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="455" y="115" width="410" height="155" as="geometry"/></mxCell>
<mxCell id="care" value="care_team&#xa;PK (patient_id, doctor_id)&#xa;Both IDs reference profiles.id&#xa;Triggers verify roles" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf3f9;strokeColor=#5c7e9e;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="455" y="405" width="410" height="110" as="geometry"/></mxCell>
<mxCell id="records" value="medical_records&#xa;PK id; FK patient_id + doctor_id&#xa;Composite FK → care_team&#xa;type, content, timestamp, image_url&#xa;Existing records constrain unlinking" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f0e9;strokeColor=#3b7256;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="905" y="660" width="350" height="155" as="geometry"/></mxCell>
<mxCell id="uploads" value="patient_uploads&#xa;PK id; patient_id → profiles.id&#xa;file_name, timestamp&#xa;Filename metadata only" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf3f9;strokeColor=#5c7e9e;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="405" width="330" height="130" as="geometry"/></mxCell>
<mxCell id="healing" value="healing_progress&#xa;PK id; patient_id → profiles.id&#xa;status_type, value 1–10, timestamp&#xa;History stored; UI shows latest/type" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf3f9;strokeColor=#5c7e9e;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="690" width="330" height="130" as="geometry"/></mxCell>
<mxCell id="biometrics" value="mock_biometric_data&#xa;PK id; doctor_id → profiles.id&#xa;heart_rate, sleep_hours, timestamp&#xa;UI reads latest synthetic sample" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf3f9;strokeColor=#5c7e9e;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="905" y="405" width="350" height="130" as="geometry"/></mxCell>
<mxCell id="sql" value="How Go connects&#xa;Store interface → postgresStore&#xa;database/sql + lib/pq + DATABASE_URL&#xa;No browser SQL / Supabase client&#xa;Apply SQL separately" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f0e9;strokeColor=#3b7256;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="455" y="885" width="410" height="125" as="geometry"/></mxCell>
<mxCell id="rules" value="Database guards&#xa;NOT NULL / CHECK constraints&#xa;Foreign keys + role triggers&#xa;Immutable profile role&#xa;RLS enabled; no browser policies&#xa;Backend needs appropriate privileges" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f2f4f5;strokeColor=#819098;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="330" height="160" as="geometry"/></mxCell>
<mxCell id="missing" value="Not persisted in these tables&#xa;App sessions and eventHub&#xa;Actual uploaded file bytes&#xa;Wearable connection or LLM output&#xa;Verified identity/auth ownership" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3df;strokeColor=#b17b2c;fontColor=#243f32;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="905" y="115" width="350" height="155" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
</mxfile>